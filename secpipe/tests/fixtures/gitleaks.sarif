{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "gitleaks",
     "semanticVersion": "v8.0.0",
     "informationUri": "https://github.com/gitleaks/gitleaks",
     "rules": [
      {
       "id": "aws-access-token",
       "shortDescription": {
        "text": "Identified a pattern that may indicate AWS credentials, risking unauthorized cloud resource access and data breaches on AWS platforms."
       }
      },
      {
       "id": "dockerfile-env-secret",
       "shortDescription": {
        "text": "Secret-looking value baked into an image layer with ENV/ARG"
       }
      },
      {
       "id": "secnotes-api-token",
       "shortDescription": {
        "text": "SecNotes service token (secnotes_ prefix + 32 lowercase alphanumerics)"
       }
      },
      {
       "id": "secnotes-hardcoded-db-password",
       "shortDescription": {
        "text": "Database password assigned as a string literal"
       }
      },
      {
       "id": "secnotes-hardcoded-jwt-secret",
       "shortDescription": {
        "text": "JWT signing key assigned as a string literal; it must come from a secret store"
       }
      }
     ]
    }
   },
