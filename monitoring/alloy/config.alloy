// Grafana Alloy: ship container logs and the Kubernetes API audit log to Loki.
// Stream labels (namespace, app, pod, container) are what the correlator's
// LogQL selectors and the Grafana panels use.

discovery.kubernetes "pods" {
  role = "pod"
}

discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    target_label  = "app"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_node_name"]
    target_label  = "node"
  }
  // Workloads worth keeping for security analysis; drop the rest (noise, cost).
  rule {
    source_labels = ["namespace"]
    regex         = "secnotes|ingress|monitoring|kyverno|kube-system"
    action        = "keep"
  }
}

// Tails through the Kubernetes API; clustering shares the targets between the
// DaemonSet replicas so every stream is read exactly once.
loki.source.kubernetes "pods" {
  targets    = discovery.relabel.pods.output
  forward_to = [loki.write.default.receiver]

  clustering {
    enabled = true
  }
}

// kube-apiserver audit log (kind mounts it on the control-plane node):
// who ran kubectl exec, created pods, changed RBAC.
local.file_match "audit" {
  path_targets = [{
    "__path__" = "/var/log/kubernetes/audit/*.log",
    "job"      = "kubernetes-audit",
    "source"   = "audit",
  }]
}

loki.source.file "audit" {
  targets    = local.file_match.audit.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki-gateway.monitoring.svc/loki/api/v1/push"
  }
}
